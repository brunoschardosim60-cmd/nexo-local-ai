+def _configured_scopes() -> list[str]:
+    """Allow disabling services without permitting broader OAuth scopes."""
+    raw = os.environ.get("GOOGLE_OAUTH_SCOPES", "").strip()
+    if not raw:
+        return list(MINIMAL_SCOPES)
+    requested = [scope.strip() for scope in raw.split(",") if scope.strip()]
+    unsupported = sorted(set(requested) - set(MINIMAL_SCOPES))
+    if unsupported:
+        raise RuntimeError(f"OAuth scopes outside the Nexo allowlist: {', '.join(unsupported)}")
+    if not requested:
+        raise RuntimeError("At least one Google OAuth scope is required")
+    return requested
+
+
+SCOPES = _configured_scopes()
 
