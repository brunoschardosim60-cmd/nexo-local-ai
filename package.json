{
  "name": "nexo-local-ai",
  "version": "0.9.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "agent": "node local-agent.mjs",
    "tts:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tts/setup-piper.ps1",
    "tts:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/tts/start-piper.ps1",
    "test:agent": "node --test agent/tests/*.test.mjs",
    "test:ux": "node --test agent/tests/ux-ui-v2.test.mjs",
    "eval:agent": "node agent/evals/runtime-eval.mjs",
    "eval:intelligence": "node agent/evals/intelligence-v4-eval.mjs",
    "eval:media": "node agent/evals/media-v4-eval.mjs",
    "eval:autonomy": "node agent/evals/autonomy-v5-eval.mjs",
    "eval:memory": "node agent/evals/memory-v6-eval.mjs memory",
    "eval:memory-long": "node agent/evals/memory-v6-eval.mjs long",
    "eval:false-memory": "node agent/evals/memory-v6-eval.mjs false",
    "eval:knowledge": "node agent/evals/memory-v6-eval.mjs graph",
    "eval:personal": "node agent/evals/personal-v7-eval.mjs",
    "eval:multimodal": "node agent/evals/multimodal-v8-eval.mjs",
    "eval:extensions": "node agent/evals/extensions-v9-eval.mjs",
    "eval:coding-browser": "node agent/evals/coding-browser-v10-eval.mjs",
    "eval:conversation": "node agent/evals/conversation-v10-eval.mjs",
    "eval:conversation-live": "node agent/evals/conversation-v10-live.mjs",
    "eval:conversation-manual": "node agent/evals/conversation-v10-manual-review.mjs",
    "eval:self-capabilities": "node agent/evals/capability-self-live.mjs",
    "eval:full-live": "node agent/evals/full-capabilities-live.mjs",
    "benchmark:conversation": "node agent/evals/conversation-model-benchmark.mjs",
    "eval:master": "node agent/evals/master-golden-eval.mjs",
    "benchmark:memory": "node agent/evals/memory-v6-eval.mjs performance",
    "benchmark:v4": "node agent/evals/performance-v4.mjs",
    "benchmark:v5": "node agent/evals/performance-v4.mjs",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "playwright-core": "^1.62.1",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260830.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
